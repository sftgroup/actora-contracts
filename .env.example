# Actora contracts — environment template
#
# 用法：复制为 contracts/.env（该文件已被 .gitignore 忽略），按需填写。
#   cp .env.example .env
# Foundry 会自动读取 contracts/.env；也可 `set -a; . ./.env; set +a` 后显式 export。
#
# 安全：PRIVATE_KEY 只用于部署/运维脚本，切勿提交、切勿用于存放平台资金的地址。
# 生产部署请使用独立部署者钱包，完成后把 owner 转到冷钱包（见 CONTRACTS.md §Owners）。

# ── RPC（foundry.toml [rpc_endpoints]）────────────────────────────────────────
# 公共节点仅适合本地/测试；生产请换自有 RPC。
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# BSC / Base 部署脚本通过 --rpc-url 传入（公共节点，可替换）
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com

# ── 浏览器验证（forge verify-contract）───────────────────────────────────────
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
# BscScan 需要单独的 key（forge 目前未在 foundry.toml 配置 bsc，按需临时传入）
BSCSCAN_API_KEY=

# ── 部署/运维脚本必填 ────────────────────────────────────────────────────────
# script/DeployA2A.s.sol、DeployPaymentReputationOracle*.s.sol、ZeroPlatformFee.s.sol、
# RotateOwnership.s.sol、RotateSettlementWriter.s.sol、rotate-owner.sh
PRIVATE_KEY=
# 部署 ValidationRegistry 时若无 PRIVATE_KEY，可用已有地址做 dry-run
DEPLOYER=

# ── 部署脚本可选参数（不填则用脚本内默认值）─────────────────────────────────
# A2A / ValidationRegistry
IDENTITY_REGISTRY=
CANONICAL_IDENTITY=

# PaymentReputationOracle(V2)
SETTLEMENT_VERIFIER=
SUBSCRIPTION_MANAGER=
REPUTATION_REGISTRY=
ORACLE_OWNER=
WEIGHT_AMOUNT_CAP=100000000000000000000
WEIGHT_MAX_AGE=15552000
WEIGHT_PAYER_CAP=3
VERIFIER_MODE=erc8183
ERC8183_COMMERCE=

# SettlementRegistry writer 轮换
SETTLEMENT_REGISTRY=
WRITER=
ACTION=grant          # grant | revoke

# Ownership / fee 轮换
NEW_OWNER=
NEW_COLLECTOR=
A2A_PROTOCOL=
VALIDATION_REGISTRY=
CONFIGURATION_REGISTRY=
MULTI_ENDPOINT=
PAYMENT_REPUTATION_ORACLE=
PAYMENT_REPUTATION_ORACLE_V2=
MAX_AGENTS=200
DRY_RUN=1             # 预演优先；确认后再置 0
